# Artefatos: os tensores grandes (>100 MB) sao gerados pelo notebook;
# versionamos apenas os pequenos (modelos, grafo, limiares, resultados).
artifacts/*
!artifacts/*.json
!artifacts/graph_data.pkl
!artifacts/tau.pkl
!artifacts/sigma_inv.pkl
!artifacts/model_plu.pt
!artifacts/model_temp.pt

